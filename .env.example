# Reference values for the env vars the app and Alembic read. Nothing auto-loads this
# file: the app does NOT read .env (model_config sets no env_file) and docker-compose.yml
# hardcodes its own credentials (no ${...} interpolation). To use these for host-run
# uvicorn/alembic, export them (e.g. `set -a; source .env; set +a`).
#
# Application / dev database (defaults to this exact value if unset):
MATHION_DATABASE_URL=postgresql+psycopg://mathion:mathion@localhost:5432/mathion
#
# Test database — MUST be a distinct database whose name matches mathion_test / mathion_test_*.
# The test harness DROPs and recreates this database's schema; never point it at dev/prod.
MATHION_TEST_DATABASE_URL=postgresql+psycopg://mathion:mathion@localhost:5432/mathion_test
