    "html/h_staff.html": "<p>Answers for the teaching team.</p>\n",
    "html/h_staff.xml": "<html filename=\"h_staff\" display_name=\"Staff only\"/>\n",
    "html/h_welcome.html": "<h2>Welcome</h2>\n<p>This course uses formulas like \\(x^2 + y^2 = r^2\\) and</p>\n<p>\\[\\sigma = \\sqrt{\\frac{1}{n}\\sum_{i=1}^{n}(x_i-\\bar{x})^2}\\]</p>\n<p>See <a href=\"/static/notes.pdf\">the notes</a>.</p>\n<p><img src=\"/static/img/fig 1.png\" alt=\"Figure 1\"/></p>\n",
    "html/h_welcome.xml": "<html filename=\"h_welcome\" display_name=\"Text\"/>\n",
    "policies/2026_T1/policy.json": "{\"course/2026_T1\": {\"display_name\": \"Synthetic Demo Course\", \"max_attempts\": 2, \"showanswer\": \"finished\"}}\n",
    "problem/p_checkbox.xml": "<problem display_name=\"Checkboxes\">\n  <p>Select the prime numbers.</p>\n  <choiceresponse>\n    <checkboxgroup>\n      <choice correct=\"true\">2</choice>\n      <choice correct=\"true\">3</choice>\n      <choice correct=\"false\">4</choice>\n    </checkboxgroup>\n  </choiceresponse>\n  <choiceresponse>\n    <label>Select the vowels.</label>\n    <checkboxgroup>\n      <choice correct=\"true\">a</choice>\n      <choice correct=\"false\">b</choice>\n      <choice correct=\"true\">e</choice>\n    </checkboxgroup>\n  </choiceresponse>\n</problem>\n",
    "problem/p_dropdown.xml": "<problem display_name=\"Dropdowns\">\n  <p>The capital of France is</p>\n  <optionresponse>\n    <optioninput options=\"('Paris','Lyon','Nice')\" correct=\"Paris\"/>\n  </optionresponse>\n  <optionresponse>\n    <label>The square root of 16 is</label>\n    <optioninput>\n      <option correct=\"False\">2</option>\n      <option correct=\"True\">4</option>\n      <option correct=\"False\">8</option>\n    </optioninput>\n  </optionresponse>\n</problem>\n",
    "problem/p_mc.xml": "<problem display_name=\"Single choice\" max_attempts=\"2\" showanswer=\"finished\" weight=\"1\">\n  <p>Which number is even?</p>\n  <multiplechoiceresponse>\n    <choicegroup type=\"MultipleChoice\">\n      <choice correct=\"false\">3</choice>\n      <choice correct=\"true\">4</choice>\n      <choice correct=\"false\">\\(\\pi\\)</choice>\n    </choicegroup>\n  </multiplechoiceresponse>\n  <solution>\n    <div class=\"detailed-solution\">\n      <p>Explanation</p>\n      <p>4 is divisible by 2.</p>\n    </div>\n  </solution>\n  <multiplechoiceresponse>\n    <label>What is \\(2 + 3\\)?</label>\n    <description>Pick one.</description>\n    <choicegroup type=\"MultipleChoice\" shuffle=\"true\">\n      <choice correct=\"true\">5<choicehint>Right.</choicehint></choice>\n      <choice correct=\"false\">6</choice>\n    </choicegroup>\n    <solution>\n      <div class=\"detailed-solution\"><p>Explanation</p><p>Add them.</p></div>\n    </solution>\n  </multiplechoiceresponse>\n  <demandhint>\n    <hint>Count on your fingers.</hint>\n  </demandhint>\n</problem>\n",
    "problem/p_numeric.xml": "<problem display_name=\"Numbers\">\n  <p>What is \\(0.5 \\times 160\\)?</p>\n  <numericalresponse answer=\"80\">\n    <formulaequationinput/>\n  </numericalresponse>\n  <numericalresponse answer=\"9.81\">\n    <label>Give the acceleration of gravity in m/s<sup>2</sup>.</label>\n    <responseparam type=\"tolerance\" default=\"1%\"/>\n    <formulaequationinput/>\n  </numericalresponse>\n</problem>\n",
    "problem/p_string.xml": "<problem display_name=\"Text answers\">\n  <p>Name the capital of Denmark.</p>\n  <stringresponse answer=\"Copenhagen\" type=\"ci\">\n    <additional_answer answer=\"København\"/>\n    <textline size=\"20\"/>\n  </stringresponse>\n  <stringresponse answer=\"mean\" type=\"\">\n    <label>Which statistic is the sum divided by the count?</label>\n    <textline size=\"20\"/>\n  </stringresponse>\n</problem>\n",
